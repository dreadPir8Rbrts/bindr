# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Bindr Supabase Postgres (direct connection string locally).
BINDR_SUPABASE_CONNECTION=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Google Cloud Vision for the card scanner: base64 service-account JSON, or an API key.
GOOGLE_CREDENTIALS_BASE64=
# GOOGLE_VISION_API_KEY=

# Supabase Auth (seller sign-in). Both are public values, served to the browser by /api/v1/config.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# S3 photo storage (IAM user limited to the bucket's photo folders).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_S3_BUCKET=
# Local runs keep their uploads in dev/photos/; production uses photos/.
S3_KEY_PREFIX=dev/photos/
# Optional CDN (e.g. CloudFront) in front of the bucket; defaults to the bucket URL.
# S3_PUBLIC_BASE_URL=
